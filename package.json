{
  "name": "dsh-balance-display-simple",
  "version": "0.1.2",
  "description": "Show the DeepSeek API account balance under the DSH sidebar brand row, refreshed every 60 seconds through a same-origin endpoint so the browser never touches the API key.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "deepseek",
    "balance",
    "usage"
  ],
  "license": "MIT",
  "author": "happyde2b",
  "homepage": "https://github.com/happyde2b/dsh-balance-display-simple#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyde2b/dsh-balance-display-simple.git"
  },
  "bugs": {
    "url": "https://github.com/happyde2b/dsh-balance-display-simple/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
